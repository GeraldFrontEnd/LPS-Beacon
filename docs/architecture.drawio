itDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeWidth=3;" edge="1" parent="1" source="lapi" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="④ Upload files, then manifest.json last (pre-signed URLs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#2DA44E;fontColor=#2DA44E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="368" y="340"/><mxPoint x="368" y="105"/><mxPoint x="1110" y="105"/></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#2DA44E;fontColor=#2DA44E;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="data" target="evt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="T1 upload batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="evt" target="lpipe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="T2 monthly · T3 quarterly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="sch" target="lpipe"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="T4 what-if" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="lapi" target="lpipe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#D97706;fontColor=#D97706;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="lpipe" target="br"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="R1 write results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#0E9F9A;fontColor=#0E9F9A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeWidth=3;" edge="1" parent="1" source="lpipe" target="data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="290"/><mxPoint x="1165" y="290"/></Array></mxGeometry></mxCell><mxCell id="e26" value="R2 read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#0E9F9A;fontColor=#0E9F9A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;" edge="1" parent="1" source="data" target="lapi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="R3 chat prompt ⇄ answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#0E9F9A;fontColor=#0E9F9A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=3;jumpStyle=arc;jumpSize=12;" edge="1" parent="1" source="lapi" target="br"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="495"/><mxPoint x="1670" y="495"/></Array></mxGeometry></mxCell><mxCell id="e28" value="H save / load chats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#C925D1;fontColor=#C925D1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;" edge="1" parent="1" source="lapi" target="ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#8E44AD;fontColor=#8E44AD;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lpipe" target="sns"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="346"/><mxPoint x="1530" y="195"/></Array></mxGeometry></mxCell><mxCell id="e30" value="R5 email: run summary + link to app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#8E44AD;fontColor=#8E44AD;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sns" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1670" y="62"/><mxPoint x="190" y="62"/></Array></mxGeometry></mxCell><mxCell id="flow" value="&lt;b style='font-size:14px'&gt;Requests &amp;amp; triggers&lt;/b&gt;&lt;br&gt;① Open app through CloudFront — WAF filters bad IPs, common exploits and request floods&lt;br&gt;② Sign in on the Cognito login page: email + password + authenticator-app MFA → JWT&lt;br&gt;③ App calls the API with the JWT; API Gateway's JWT authorizer rejects anything not issued by this user pool&lt;br&gt;④ Browser uploads the batch to raw/{batch_id}/ with pre-signed URLs, manifest.json last&lt;br&gt;&lt;b&gt;T1&lt;/b&gt; manifest.json → S3 event → pipeline (one run per batch)   &lt;b&gt;T2&lt;/b&gt; monthly   &lt;b&gt;T3&lt;/b&gt; quarterly   &lt;b&gt;T4&lt;/b&gt; re-run / what-if from chat&lt;br&gt;&lt;br&gt;&lt;b style='font-size:14px;color:#0E9F9A'&gt;Results back to the user&lt;/b&gt;&lt;br&gt;&lt;b&gt;R1&lt;/b&gt; Pipeline writes results/{run_id}.json (forecast table, supply-vs-demand gaps, Plotly chart specs, narrative), curated Parquet and the data-quality report&lt;br&gt;&lt;b&gt;R2&lt;/b&gt; API Lambda reads the latest results for run status, charts and chat context&lt;br&gt;&lt;b&gt;R3&lt;/b&gt; API Lambda sends question + results summary to Bedrock; Bedrock returns the answer&lt;br&gt;&lt;b&gt;R4&lt;/b&gt; JSON response returns API Lambda → API Gateway → CloudFront → web app, which renders the chat reply, charts, forecast table and DQ report&lt;br&gt;&lt;b&gt;R5&lt;/b&gt; Scheduled runs (T2/T3) and alerts also email a summary + link via SNS&lt;br&gt;&lt;br&gt;&lt;b style='font-size:14px;color:#C925D1'&gt;Chat history in the sidebar (H)&lt;/b&gt;&lt;br&gt;&lt;b&gt;H1&lt;/b&gt; Page load → GET /sessions → API Lambda queries DynamoDB by the user's Cognito ID → sidebar lists their chats, newest first&lt;br&gt;&lt;b&gt;H2&lt;/b&gt; Each /chat call saves the question and the answer (with any run IDs) to DynamoDB; the first message gets an auto-title&lt;br&gt;&lt;b&gt;H3&lt;/b&gt; Clicking a past chat → GET /sessions/{id}/messages → messages reload and charts re-render from results/ via the stored run IDs" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;rounded=1;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="980" height="360" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style='font-size:14px'&gt;Line colours&lt;/b&gt;&lt;br&gt;&lt;font color='#1F6FEB'&gt;&lt;b&gt;━ Blue&lt;/b&gt;&lt;/font&gt; requests to the API&lt;br&gt;&lt;font color='#0E9F9A'&gt;&lt;b&gt;━ Teal (thick)&lt;/b&gt;&lt;/font&gt; results back to the user&lt;br&gt;&lt;font color='#C62828'&gt;&lt;b&gt;┅ Red dashed&lt;/b&gt;&lt;/font&gt; identity&lt;br&gt;&lt;font color='#2DA44E'&gt;&lt;b&gt;━ Green&lt;/b&gt;&lt;/font&gt; file upload&lt;br&gt;&lt;font color='#D97706'&gt;&lt;b&gt;━ Orange&lt;/b&gt;&lt;/font&gt; triggers &amp;amp; AI&lt;br&gt;&lt;font color='#8E44AD'&gt;&lt;b&gt;━ Purple&lt;/b&gt;&lt;/font&gt; notifications&lt;br&gt;&lt;font color='#C925D1'&gt;&lt;b&gt;━ Magenta&lt;/b&gt;&lt;/font&gt; chat history" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;rounded=1;strokeColor=#BDBDBD;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1015" y="1140" width="250" height="360" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b style='font-size:14px'&gt;Estimated monthly cost — ap-southeast-1 (Singapore)&lt;/b&gt;&lt;br&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;width:100%'&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;Service&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;Usage basis (pilot / growth)&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;Pilot&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;Growth&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;Bedrock · Haiku 4.5 chat&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;600 / 6,000 msgs × 6k in + 0.5k out tokens&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$5.10&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$51.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;Bedrock · Sonnet 4.5 narratives&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;20 / 60 runs × 12k in + 1.5k out tokens&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$1.20&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$3.50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;AWS WAF&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;Web ACL $5 + 3 rules × $1 + requests&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$8.05&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$8.30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;S3 (web + data)&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;5 / 50 GB Standard + requests&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0.15&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$1.30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;ECR&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;~1 GB container image&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0.10&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;API GW · DynamoDB · CloudTrail&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;~3.5k / 35k API calls; small tables&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0.05&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;Lambda (both functions)&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;~6k / 32k GB-s — inside always-free 400k GB-s&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;CloudFront · Cognito · CloudWatch · SNS · Scheduler · Budgets&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;within always-free tiers&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;$0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;Total / month&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;≈ $14.65&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:2px 5px;border-bottom:1px solid #CFE8D5;vertical-align:top'&gt;&lt;b&gt;≈ $64.30&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style='font-size:10px'&gt;Pilot = 20 users · 30 chats/user · 20 pipeline runs. Growth = 200 users · 60 runs. Bedrock via global cross-region inference (in-region APAC endpoints cost slightly more). Excludes tax, support plan, SMS MFA, custom domain.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;rounded=1;strokeColor=#2DA44E;strokeWidth=2;fillColor=#F3FBF5;" vertex="1" parent="1"><mxGeometry x="1280" y="1140" width="540" height="360" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
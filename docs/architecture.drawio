<mxfile host="app.diagrams.net"><diagram name="Public MVP v9 (CloudFront + WAF, refined cost estimate)" id="mvp9"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1850" pageHeight="1530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Resource &amp;amp; Headcount Forecast Chatbot — Public MVP v9 (CloudFront + WAF, refined cost estimate)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Public web app · sign-in with email + password + MFA (Cognito) · chat history · serverless, pay-per-use · AWS WAF on CloudFront · est. ≈ $15/month at pilot scale (Singapore)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1600" height="56" as="geometry"/></mxCell><mxCell id="corp" value="Public internet" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#F4F7FB;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="330" height="400" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud — single region (ap-southeast-1, Singapore)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="1430" height="1040" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style='font-size:13px'&gt;Registered user&lt;/b&gt;&lt;br&gt;Signed-up account with MFA enabled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="240" height="130" as="geometry"/></mxCell><mxCell id="user_i" value="" style="shape=umlActor;html=1;outlineConnect=0;" vertex="1" parent="user"><mxGeometry x="19" y="14" width="26" height="46" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b style='font-size:13px'&gt;Chatbot web app&lt;/b&gt;&lt;br&gt;React SPA: chat + &lt;b&gt;history sidebar&lt;/b&gt;, CSV/XLSX upload, charts, DQ report" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FEB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="240" height="130" as="geometry"/></mxCell><mxCell id="browser_i" value="" style="sketch=0;aspect=fixed;pointerEvents=1;dashed=0;html=1;strokeColor=none;fillColor=#00188D;shape=mxgraph.azure.computer;" vertex="1" parent="browser"><mxGeometry x="10" y="14" width="44" height="40" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style='font-size:13px'&gt;S3 — web app&lt;/b&gt;&lt;br&gt;Private bucket; read only by CloudFront (OAC)&lt;br&gt;&lt;i&gt;≈ $0.01/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="220" height="130" as="geometry"/></mxCell><mxCell id="web_i" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;fillColor=#7AA116;shape=mxgraph.aws4.bucket;" vertex="1" parent="web"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b style='font-size:13px'&gt;CloudFront&lt;/b&gt;&lt;br&gt;Pay-as-you-go · HTTPS · app + /api/* · WAF attached&lt;br&gt;&lt;i&gt;$0 (always-free tier)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="220" height="130" as="geometry"/></mxCell><mxCell id="cf_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fillColor=#8C4FFF;" vertex="1" parent="cf"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style='font-size:13px'&gt;API Gateway&lt;/b&gt;&lt;br&gt;HTTP API · Cognito JWT authorizer · /chat /sessions /upload-url /runs /analysis /dashboard&lt;br&gt;&lt;i&gt;&amp;lt; $0.01/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="720" y="320" width="220" height="130" as="geometry"/></mxCell><mxCell id="api_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B;" vertex="1" parent="api"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="cog" value="&lt;b style='font-size:13px'&gt;Cognito&lt;/b&gt;&lt;br&gt;Essentials tier · email + password · authenticator-app MFA&lt;br&gt;&lt;i&gt;$0 (10k MAU free)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="720" y="540" width="220" height="130" as="geometry"/></mxCell><mxCell id="cog_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fillColor=#DD344C;" vertex="1" parent="cog"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="data" value="&lt;b style='font-size:13px'&gt;S3 data bucket&lt;/b&gt;&lt;br&gt;raw · clean · curated · results · quarantine&lt;br&gt;&lt;i&gt;≈ $0.15/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="220" height="130" as="geometry"/></mxCell><mxCell id="data_i" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;fillColor=#7AA116;shape=mxgraph.aws4.bucket;" vertex="1" parent="data"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="evt" value="&lt;b style='font-size:13px'&gt;S3 event&lt;/b&gt;&lt;br&gt;raw/*/manifest.json created → 1 pipeline run per batch&lt;br&gt;&lt;i&gt;$0&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1280" y="130" width="220" height="130" as="geometry"/></mxCell><mxCell id="evt_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;fillColor=#7AA116;" vertex="1" parent="evt"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="lapi" value="&lt;b style='font-size:13px'&gt;API Lambda&lt;/b&gt;&lt;br&gt;Upload URLs, status, chat, history · user ID from JWT&lt;br&gt;&lt;i&gt;$0 (free tier)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="220" height="130" as="geometry"/></mxCell><mxCell id="lapi_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="lapi"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="lpipe" value="&lt;b style='font-size:13px'&gt;Pipeline Lambda&lt;/b&gt;&lt;br&gt;Container · 3 GB · 15 min · concurrency 1&lt;br&gt;&lt;i&gt;$0 (free tier)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1280" y="320" width="220" height="130" as="geometry"/></mxCell><mxCell id="lpipe_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="lpipe"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="br" value="&lt;b style='font-size:13px'&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Haiku 4.5 chat · Sonnet 4.5 run narratives&lt;br&gt;&lt;i&gt;≈ $6.30/mo (main cost)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1560" y="320" width="220" height="130" as="geometry"/></mxCell><mxCell id="br_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fillColor=#01A88D;" vertex="1" parent="br"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="sns" value="&lt;b style='font-size:13px'&gt;SNS → email&lt;/b&gt;&lt;br&gt;Run done, shortfall and failure alerts&lt;br&gt;&lt;i&gt;$0 (free tier)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E44AD;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1560" y="130" width="220" height="130" as="geometry"/></mxCell><mxCell id="sns_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;" vertex="1" parent="sns"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b style='font-size:13px'&gt;DynamoDB&lt;/b&gt;&lt;br&gt;On-demand · chats, runs, what-ifs, audit log · TTL&lt;br&gt;&lt;i&gt;&amp;lt; $0.01/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C925D1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1000" y="540" width="220" height="130" as="geometry"/></mxCell><mxCell id="ddb_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="ddb"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b style='font-size:13px'&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;Monthly + quarterly forecast runs&lt;br&gt;&lt;i&gt;$0 (free tier)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1280" y="540" width="220" height="130" as="geometry"/></mxCell><mxCell id="sch_i" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;fillColor=#E7157B;shape=mxgraph.aws4.eventbridge_scheduler;" vertex="1" parent="sch"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="pp" value="Inside the Pipeline Lambda — pandas + openpyxl (about 2 s for the sample files)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFF8F0;strokeColor=#ED7100;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#8A4B00;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="1380" height="170" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;1 Fingerprint&lt;/b&gt;&lt;br&gt;SHA-256 per file; skip identical duplicates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="432" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2 Detect&lt;/b&gt;&lt;br&gt;Find header row &amp;amp; sheet by column signature, not filename" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="584" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3 Standardise&lt;/b&gt;&lt;br&gt;Trim, strip hidden chars, snake_case, synonym map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="736" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;4 Fix types&lt;/b&gt;&lt;br&gt;Excel serials → dates, grade → int, 'Generic 4' → grade 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="888" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;5 Reshape&lt;/b&gt;&lt;br&gt;Unpivot May…Mar + FY → one row per month" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;6 De-duplicate&lt;/b&gt;&lt;br&gt;Exact rows + business keys; latest Modified Date wins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1192" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;7 Validate&lt;/b&gt;&lt;br&gt;Leavers, unknown IT codes, missing grade → quarantine + DQ report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1344" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;8 Match &amp;amp; forecast&lt;/b&gt;&lt;br&gt;Supply vs demand by grade / month → gap, UR trend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1496" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;9 Publish&lt;/b&gt;&lt;br&gt;Bedrock summary → Parquet + results JSON → SNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1648" y="740" width="140" height="110" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=block;endFill=1;html=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sec" value="Security &amp;amp; operations" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F7F7F7;strokeColor=#BDBDBD;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="420" y="910" width="1380" height="180" as="geometry"/></mxCell><mxCell id="sec1" value="&lt;b style='font-size:13px'&gt;IAM&lt;/b&gt;&lt;br&gt;Least-privilege role per Lambda&lt;br&gt;&lt;i&gt;$0&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="440" y="950" width="255" height="110" as="geometry"/></mxCell><mxCell id="sec1_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="sec1"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="sec2" value="&lt;b style='font-size:13px'&gt;ECR&lt;/b&gt;&lt;br&gt;Pipeline container image (~1 GB)&lt;br&gt;&lt;i&gt;≈ $0.10/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="715" y="950" width="255" height="110" as="geometry"/></mxCell><mxCell id="sec2_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fillColor=#ED7100;" vertex="1" parent="sec2"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="sec3" value="&lt;b style='font-size:13px'&gt;CloudWatch + Budgets&lt;/b&gt;&lt;br&gt;Logs, error alarm, spend alert&lt;br&gt;&lt;i&gt;$0 (5 GB logs free)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="990" y="950" width="255" height="110" as="geometry"/></mxCell><mxCell id="sec3_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="sec3"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="sec4" value="&lt;b style='font-size:13px'&gt;CloudTrail&lt;/b&gt;&lt;br&gt;API and S3 data-event audit trail&lt;br&gt;&lt;i&gt;≈ $0.01/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1265" y="950" width="255" height="110" as="geometry"/></mxCell><mxCell id="sec4_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;fillColor=#E7157B;" vertex="1" parent="sec4"><mxGeometry x="10" y="14" width="44" height="44" as="geometry"/></mxCell><mxCell id="sec5" value="&lt;b style='font-size:13px'&gt;AWS WAF&lt;/b&gt;&lt;br&gt;Core rules · IP reputation · rate limit (100 req / 5 min / IP)&lt;br&gt;&lt;i&gt;≈ $8.05/mo&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=60;spacingTop=6;spacingRight=6;fontSize=11;fontColor=#232F3E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1540" y="950" width="240" height="110" as="geometry"/></mxCell><mxCell id="sec5_i" value="" style="sketch=0;outlineConnect=0;strokeColor=#ff